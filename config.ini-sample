[MapQuest]
key=your-api-key-goes-here
# When True, skip cn_locations translation and use raw names from the
# geocoding service (MapQuest or ExifTool) directly.
# When False (default), translate place names to Chinese via the built-in
# dictionary and fallback layers.
prefer_english_names=False

# Amap (高德地图) API key for Chinese location reverse geocoding.
# When configured, photos taken in China will use Amap to get Chinese place
# names directly (province/city/district/town). International photos fall
# back to Nominatim (OpenStreetMap) for Chinese translations.
# Get a free key at https://console.amap.com/ (5000 calls/day).
[Amap]
key=your-amap-key-goes-here

# Optional: when set, files are grouped by location relative to home.
# Full templates live under [Directory]:
#   full_path                  other countries     %country/%date/%state/%city
#   full_path_home_country     home country, other province  %country/%state/%date/%city
#   full_path_home_province    home province       %country/%state/%city/%date
#
# [Home]
# country=中国
# state=四川省
